class Solution:
    def merge(self, intervals: List[List[int]]) -> List[List[int]]:
        intervals.sort(key = lambda interval: interval[0])
        new = []
        for interval in intervals:
            if not new or new[-1][1] < interval[0]:
                new.append(interval)
            else:
                new[-1] = [new[-1][0], max(new[-1][1], interval[1])]

        return new
