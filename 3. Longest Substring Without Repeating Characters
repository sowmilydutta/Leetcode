class Solution:
    def lengthOfLongestSubstring(self, s: str) -> int:
        left = 0
        longest = 0
        set_s = set()
        n = len(s)

        for right in range(n):
            while s[right] in set_s:
                set_s.remove(s[left])
                left = left+1
            
            window = right - left + 1
            longest = max(longest, window)
            set_s.add(s[right])

        return longest


