class Solution:
    def fib(self, n: int) -> int:
        # golden_ratio = (1 + (5 ** 0.5)) / 2
        # return int(round((golden_ratio ** n) / (5 ** 0.5)))
         if n<=1: return n

         prev = 0
         curr = 1

         for i in range(2, n+1):
             prev, curr = curr, prev + curr
        
         return curr
        
